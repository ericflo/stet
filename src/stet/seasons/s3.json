        "parts": [
          "news"
        ],
        "about": "fresh news published in the day before the draw: same continuation under the real opening vs same-source wrong openings"
      },
      "technical": {
        "group": "comprehension",
        "parts": [
          "technical"
        ],
        "about": "fresh issues, patches and technical writing: same continuation under the real opening vs same-source wrong openings"
      },
      "conversation": {
        "group": "comprehension",
        "parts": [
          "discussion",
          "social"
        ],
        "about": "fresh replies and posts: same continuation under the real opening vs same-source wrong openings"
      },
      "explain": {
        "group": "reasoning",
        "parts": [
          "explain"
        ],
        "about": "fresh harvest-derived multi-sentence causal and mechanism explanations in the excerpt's own language"
      },
      "infer": {
        "group": "reasoning",
        "parts": [
          "infer"
        ],
        "about": "fresh harvest-derived analytical synthesis of implications and trade-offs in the excerpt's own language"
      },
      "synthesis": {
        "group": "reasoning",
        "parts": [
          "synthesis"
        ],
        "about": "fresh harvest-derived declarative prose synthesis of the excerpt's main point and rationale (zero Q/A syntax)"
      }
    }
